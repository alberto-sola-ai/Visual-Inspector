{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Principal": "Server=localhost;Port=3306;Database=visualinspector;User=visualinspector;"
  },
  "Aplicacion": {
    "Nombre": "Visual Inspector",
    "Empresa": "Witte y Solà, S.A."
  },
  "UsuariosIniciales": {
    "CrearUsuarioPrueba": true
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Expressions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "Categoria = 'Seguridad'"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "log/Log-Wys-Seg-.log",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 90,
                  "outputTemplate": "{Timestamp:dd/MM/yyyy HH:mm:ss} | {Message:lj}{NewLine}"
                }
              }
            ]
          }
        }
      },
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByIncludingOnly",
                "Args": {
                  "expression": "@l in ['Warning', 'Error', 'Fatal'] and Categoria is null"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "File",
                "Args": {
                  "path": "log/err-log-.log",
                  "rollingInterval": "Day",
                  "retainedFileCountLimit": 30,
                  "outputTemplate": "{Timestamp:dd/MM/yyyy HH:mm:ss} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
              }
            ]
          }
        }
      }
    ]
  },
  "Seguridad": {
    "MinutosInactividadSesion": 30,
    "UsarCabecerasProxy": false,
    "OrigenesCorsPermitidos": []
  }
}
