# Copia este archivo como ".env" y rellena los valores. ".env" NUNCA se sube a GitHub.
# Ámbito Interno WYS: no hay certificados (la red de la empresa gestiona el cifrado).
ASPNETCORE_ENVIRONMENT=Production

# Base de datos
MARIADB_DATABASE=visualinspector
MARIADB_USER=visualinspector
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Usuarios iniciales (se piden cambiar en la primera entrada)
# Si se dejan vacías, la aplicación genera una y la muestra una vez en la consola
# (docker compose logs app).
PASSWORD_ADMIN=
PASSWORD_PRUEBA=
# En producción, normalmente sin usuario de prueba
CREAR_USUARIO_PRUEBA=false

# IA: la aplicación todavía no usa inteligencia artificial. Cuando la use, se añadirán aquí
# IA_API_KEY y las variables de límites (opcionales y desactivadas por defecto).
