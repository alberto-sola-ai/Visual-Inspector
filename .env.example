# Copia este archivo como ".env" y rellena los valores. ".env" NUNCA se sube a GitHub.
# Ámbito Interno WYS: la aplicación no lleva certificados. En producción el certificado lo pone
# Nginx Proxy Manager, que está delante de la aplicación.
ASPNETCORE_ENVIRONMENT=Production

# Publicación detrás de Nginx Proxy Manager (en el PC de desarrollo, false y vacío)
# true: la aplicación sabe la IP real del usuario y que entró por https
USAR_CABECERAS_PROXY=false
# IP de Nginx Proxy Manager tal como la ve la aplicación (por ejemplo 172.18.0.5) o su red entera
# (por ejemplo 172.18.0.0/16). Solo se aceptan las cabeceras del proxy si vienen de aquí
PROXY_CONFIABLE=

# Base de datos
MARIADB_DATABASE=visualinspector
MARIADB_USER=visualinspector
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Usuarios iniciales (se piden cambiar en la primera entrada)
# Si se dejan vacías, la aplicación genera una y la muestra una vez en la consola
# (docker compose logs app).
PASSWORD_ADMIN=
PASSWORD_PRUEBA=
# En producción, normalmente sin usuario de prueba
CREAR_USUARIO_PRUEBA=false

# ===== Planificación de producción (Google Sheets) y carpeta de patrones (desde la 0.21.0) =====
# Al desplegar en un servidor con Docker, recuerda:
# 1. Clave de Google: copia el archivo .json de la cuenta de servicio (uno solo) a la carpeta
#    wys-api-sheet/ junto a docker-compose.yml y deja que lo lea el usuario de la aplicación (1654):
#      sudo chown 1654 wys-api-sheet/*.json && sudo chmod 400 wys-api-sheet/*.json
#    El documento y la pestaña del Sheet están en appsettings.json (sección Planificacion), no aquí.
#    La hoja debe estar compartida (Lector) con el correo de la cuenta de servicio.
#    Ver doc/planificacion-google.md
# 2. Carpeta de patrones: IT monta la carpeta de red de patrones en el servidor, en solo lectura y con
#    un usuario de solo lectura (por ejemplo en /mnt/patrones), y se pone esa ruta aquí abajo en
#    PATRONES_CARPETA_SERVIDOR. Vacío: se usa la carpeta local patrones/. Ver doc/patrones.md
# 3. Después de arrancar, en la aplicación (Administración → Parámetros) revisa:
#    UsarPlanificacion = Sí, MinutosLecturaPlanificacion = 15 y CarpetaPatrones = vacío (normalmente).
# 4. Comprueba con «docker compose logs app» que sale «Hoja de planificación leída: N órdenes».
PATRONES_CARPETA_SERVIDOR=

# IA: la aplicación todavía no usa inteligencia artificial. Cuando la use, se añadirán aquí
# IA_API_KEY y las variables de límites (opcionales y desactivadas por defecto).
