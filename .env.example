# Copia este archivo como ".env" y rellena los valores. ".env" NUNCA se sube a GitHub.
# Ámbito Interno WYS: la aplicación no lleva certificados. En producción el certificado lo pone
# Nginx Proxy Manager, que está delante de la aplicación.
ASPNETCORE_ENVIRONMENT=Production

# Publicación detrás de Nginx Proxy Manager (en el PC de desarrollo, false y vacío)
# true: la aplicación sabe la IP real del usuario y que entró por https
USAR_CABECERAS_PROXY=false
# IP de Nginx Proxy Manager tal como la ve la aplicación (por ejemplo 172.18.0.5) o su red entera
# (por ejemplo 172.18.0.0/16). Solo se aceptan las cabeceras del proxy si vienen de aquí
PROXY_CONFIABLE=

# Base de datos
MARIADB_DATABASE=visualinspector
MARIADB_USER=visualinspector
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Usuarios iniciales (se piden cambiar en la primera entrada)
# Si se dejan vacías, la aplicación genera una y la muestra una vez en la consola
# (docker compose logs app).
PASSWORD_ADMIN=
PASSWORD_PRUEBA=
# En producción, normalmente sin usuario de prueba
CREAR_USUARIO_PRUEBA=false

# IA: la aplicación todavía no usa inteligencia artificial. Cuando la use, se añadirán aquí
# IA_API_KEY y las variables de límites (opcionales y desactivadas por defecto).
