@* Menú de la cabecera. Ocultar opciones aquí es solo comodidad: cada página y cada servicio
   comprueban el permiso en el servidor *@
<nav class="vi-menu">
    <AuthorizeView>
        <Authorized>
            @* Junto al logo de Visual Inspector: las secciones de trabajo *@
            <div class="vi-menu__secciones">
                <AuthorizeView Policy="@Permisos.AutocontrolesVer_wys" Context="contextoAutocontroles">
                    <NavLink href="" Match="NavLinkMatch.All">Inicio</NavLink>
                    <NavLink href="autocontroles">Autocontroles</NavLink>
                    <NavLink href="ordenes">Órdenes de Fabricación</NavLink>
                    <NavLink href="trazabilidad">Trazabilidad</NavLink>
                    <NavLink href="impacto">Impacto</NavLink>
                </AuthorizeView>
            </div>

            @* A la derecha: Administración (solo el administrador) y la persona conectada. Los menús
               desplegables los abre y cierra el navegador; wwwroot/js/menu-desplegable.js los cierra
               al pulsar fuera, al elegir una opción o con la tecla Escape *@
            <div class="vi-menu__cuenta">
                @BotonModoVisual

                <AuthorizeView Policy="@Permisos.Administracion_wys" Context="contextoAdministracion">
                    <details class="vi-desplegable vi-desplegable--claro">
                        <summary class="vi-desplegable__boton">Administración</summary>
                        <div class="vi-desplegable__opciones">
                            @foreach (var opcion in OpcionesAdministracion.Lista_wys)
                            {
                                <a href="@opcion.Direccion">@opcion.Titulo</a>
                            }
                        </div>
                    </details>
                </AuthorizeView>

                @* Menú de la persona conectada: un botón con su nombre que despliega sus opciones *@
                <details class="vi-desplegable">
                    <summary class="vi-desplegable__boton" title="Mi cuenta">
                        <span class="vi-desplegable__nombre">@(context.User.FindFirst(Permisos.TipoClaimNombreCompleto_wys)?.Value ?? context.User.Identity?.Name)</span>
                    </summary>
                    <div class="vi-desplegable__opciones">
                        <a href="Account/Manage">Mis datos</a>
                        <a href="Account/Manage/ChangePassword">Cambiar contraseña</a>
                        <hr />
                        @* Cerrar sesión es un formulario con token: nadie puede cerrar tu sesión desde otra web *@
                        <form action="Account/Logout" method="post" class="m-0">
                            <AntiforgeryToken />
                            <button type="submit">Cerrar sesión</button>
                        </form>
                    </div>
                </details>
            </div>
        </Authorized>
        <NotAuthorized>
            @* Sin sesión (pantalla de entrada) solo se ofrece el cambio de modo, también a la derecha *@
            <div class="vi-menu__cuenta">
                @BotonModoVisual
            </div>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    // Botón de la barra que cambia entre modo diurno y nocturno; lo hace wwwroot/js/modo-visual.js
    // en el navegador. Se ve un texto u otro según el modo activo (lo decide el CSS)
    private RenderFragment BotonModoVisual => @<button type="button" class="vi-desplegable__boton vi-boton-modo" data-modo-visual>
        <span class="vi-modo__ir-noche">Modo nocturno</span>
        <span class="vi-modo__ir-dia">Modo diurno</span>
    </button>;
}
