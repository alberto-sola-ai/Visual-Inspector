@page "/Account/Lockout"
@attribute [AllowAnonymous]

<PageTitle>Acceso bloqueado</PageTitle>

<h1>Acceso bloqueado</h1>
<p class="text-danger" role="alert">
    Acceso bloqueado tras 3 intentos fallidos. Inténtalo de nuevo en 15 minutos o contacta con el administrador.
</p>
<a href="Account/Login" class="btn btn-primary">Volver a la entrada</a>
