@page "/Account/Manage/ChangePassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity

@inject UserManager<UsuarioAplicacion> UserManager
@inject SignInManager<UsuarioAplicacion> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject RegistroSeguridad RegistroSeguridad

<PageTitle>Cambiar contraseña</PageTitle>

<h2 class="h4">Cambiar contraseña</h2>
@if (usuario?.DebeCambiarPassword == true)
{
    <div class="alert alert-warning" role="alert">
        Estás usando una contraseña temporal. Para seguir, elige una contraseña nueva.
    </div>
}
<StatusMessage Message="@message" />
<div class="row">
    <div class="col-8">
        <EditForm Model="Input" FormName="change-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3 vi-campo-password">
                <InputText type="password" @bind-Value="Input.OldPassword" id="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="actual" />
                <label for="Input.OldPassword" class="form-label">Contraseña actual</label>
                <BotonMostrarPassword IdCampo="Input.OldPassword" />
                <ValidationMessage For="() => Input.OldPassword" class="text-danger" />
            </div>
            <div class="form-floating mb-3 vi-campo-password">
                <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="nueva" />
                <label for="Input.NewPassword" class="form-label">Contraseña nueva</label>
                <BotonMostrarPassword IdCampo="Input.NewPassword" />
                <ValidationMessage For="() => Input.NewPassword" class="text-danger" />
            </div>
            <div class="form-floating mb-3 vi-campo-password">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="repetir" />
                <label for="Input.ConfirmPassword" class="form-label">Repite la contraseña nueva</label>
                <BotonMostrarPassword IdCampo="Input.ConfirmPassword" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>
            <p class="text-secondary small">Mínimo 8 caracteres, con al menos una mayúscula, una minúscula y un número.</p>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Cambiar contraseña</button>
        </EditForm>
    </div>
</div>

@code {
    private string? message;
    private UsuarioAplicacion? usuario;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    /// <summary>
    /// Carga a la persona conectada al abrir la pantalla.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        usuario = await UserManager.GetUserAsync(HttpContext.User);
        if (usuario is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }

    /// <summary>
    /// Cambia la contraseña. Si era temporal, quita la obligación de cambiarla y renueva la
    /// sesión para que la persona ya pueda usar la aplicación.
    /// </summary>
    private async Task OnValidSubmitAsync()
    {
        if (usuario is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var resultado = await UserManager.ChangePasswordAsync(usuario, Input.OldPassword, Input.NewPassword);
        if (!resultado.Succeeded)
        {
            await RegistroSeguridad.RegistrarAsync(AccionesSeguridad.CambioPassword_wys, "Fallido", usuario.Id);
            message = $"Error: {string.Join(" ", resultado.Errors.Select(error => error.Description))}";
            return;
        }

        var eraTemporal = usuario.DebeCambiarPassword;
        if (eraTemporal)
        {
            usuario.DebeCambiarPassword = false;
            await UserManager.UpdateAsync(usuario);
        }

        // Vuelve a preparar la tarjeta de sesión, ya sin la marca de "debe cambiar la contraseña"
        await SignInManager.RefreshSignInAsync(usuario);
        await RegistroSeguridad.RegistrarAsync(AccionesSeguridad.CambioPassword_wys, "Correcto", usuario.Id);

        if (eraTemporal)
        {
            RedirectManager.RedirectTo("");
        }
        else
        {
            RedirectManager.RedirectToCurrentPageWithStatus("Contraseña cambiada correctamente.", HttpContext);
        }
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Escribe tu contraseña actual.")]
        [DataType(DataType.Password)]
        public string OldPassword { get; set; } = "";

        [Required(ErrorMessage = "Escribe la contraseña nueva.")]
        [StringLength(100, ErrorMessage = "La contraseña nueva debe tener entre {2} y {1} caracteres.", MinimumLength = 8)]
        [DataType(DataType.Password)]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("NewPassword", ErrorMessage = "Las dos contraseñas nuevas no coinciden.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
