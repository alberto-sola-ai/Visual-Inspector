<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["VisualInspector.styles.css"]" />
    @* Marca WYS: siempre después de Bootstrap para que sus colores y tipografía manden *@
    <link rel="stylesheet" href="recursos/tema.css" />
    @* Icono de la pestaña: el símbolo de la aplicación (el manual WYS no permite la "S" sola) *@
    <link rel="icon" type="image/png" sizes="32x32" href="recursos/app/favicon-32.png" />
    <link rel="apple-touch-icon" href="recursos/app/icono-180.png" />
    <HeadOutlet @rendermode="ModoPagina" />
</head>

<body>
    <Routes @rendermode="ModoPagina" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    @* Botón "ojo" de los campos de contraseña (script propio: la CSP no permite otros) *@
    <script src="@Assets["js/mostrar-password.js"]"></script>
    @* Reloj con el turno de la barra superior *@
    <script src="@Assets["js/reloj-turno.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Las páginas de cuenta (entrar, cambiar contraseña…) se sirven como páginas web normales,
    // porque necesitan escribir la cookie de sesión; el resto son interactivas
    private IComponentRenderMode? ModoPagina =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
