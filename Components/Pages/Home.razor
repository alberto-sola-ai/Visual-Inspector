@page "/"
@attribute [Authorize(Policy = Permisos.AutocontrolesVer_wys)]

<PageTitle>Visual Inspector</PageTitle>

@* Portada: qué hace la aplicación y accesos directos a los autocontroles *@
<h1>Visual <span class="wys-ligero">Inspector</span></h1>
<p class="lead">
    Asistente para el autocontrol visual de la impresión: compara el patrón gráfico aprobado por el
    cliente (PDF) con las dos muestras escaneadas y resalta las diferencias.
</p>

<div class="row g-4 mt-2">
    <AuthorizeView Policy="@Permisos.AutocontrolesRealizar_wys">
        <div class="col-6">
            <a href="autocontroles/nuevo" class="text-decoration-none">
                <div class="wys-caja wys-caja--azul d-flex align-items-center gap-4 h-100">
                    <span class="wys-icono-circulo wys-icono-circulo--rojo">
                        <img src="recursos/iconos/blanco/notas.png" alt="" />
                    </span>
                    <div>
                        <h2 class="h4 text-white mb-1">Nuevo autocontrol</h2>
                        <p class="mb-0">Al inicio de la orden de fabricación y cuando lo consideres (se recomienda cada 4 horas).</p>
                    </div>
                </div>
            </a>
        </div>
    </AuthorizeView>
    <div class="col-6">
        <a href="autocontroles" class="text-decoration-none">
            <div class="wys-caja wys-caja--gris d-flex align-items-center gap-4 h-100">
                <span class="wys-icono-circulo">
                    <img src="recursos/iconos/blanco/ordenador_grafico.png" alt="" />
                </span>
                <div>
                    <h2 class="h4 mb-1">Autocontroles realizados</h2>
                    <p class="mb-0">Consulta los controles de cada orden de fabricación.</p>
                </div>
            </div>
        </a>
    </div>
</div>
