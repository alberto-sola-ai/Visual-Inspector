@page "/"
@attribute [Authorize(Policy = Permisos.AutocontrolesVer_wys)]
@inject NavigationManager Navegacion

@* No hay pantalla de inicio: lo importante está en Autocontroles (decisión de Alberto, 26/10/2026).
   Quien entra por la dirección raíz (por ejemplo, justo después de iniciar sesión) pasa directamente
   al listado de autocontroles. Sigue pidiendo el permiso de ver autocontroles, como antes *@

@code {
    /// <summary>
    /// Lleva a quien llega a la dirección raíz al listado de autocontroles, como un recepcionista
    /// que indica directamente la sala. "replace" evita que el botón Atrás vuelva a esta página vacía.
    /// </summary>
    protected override void OnInitialized()
    {
        Navegacion.NavigateTo("autocontroles", replace: true);
    }
}
