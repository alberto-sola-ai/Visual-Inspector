@page "/administracion/usuarios/{Id}"
@inject ServicioUsuarios ServicioUsuarios

<PageTitle>Ficha de usuario · Administración</PageTitle>

@* Ficha de un usuario: datos, estado, contraseña y permisos *@
<h1>Ficha de usuario</h1>
<p><a href="administracion">Administración</a> › <a href="administracion/usuarios">Usuarios</a> › @detalle?.Ficha.Usuario</p>

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(esError ? "alert-danger" : "alert-success")" role="alert">@mensaje</div>
}

@if (noExiste)
{
    <p>Este usuario no existe.</p>
}
else if (detalle is null)
{
    <p>Cargando…</p>
}
else
{
    <div class="row g-5">
        <div class="col-6">
            @* Datos y rol *@
            <h2 class="h4">Datos</h2>
            <div class="mb-3">
                <label class="form-label">Usuario</label>
                <input class="form-control" value="@detalle.Ficha.Usuario" disabled />
            </div>
            <div class="mb-3">
                <label class="form-label" for="nombre">Nombre completo</label>
                <input id="nombre" class="form-control" @bind="nombreCompleto" />
            </div>
            <div class="mb-3">
                <label class="form-label" for="rol">Rol</label>
                <select id="rol" class="form-select" @bind="rol">
                    @foreach (var r in ServicioUsuarios.RolesDisponibles_wys)
                    {
                        <option value="@r">@r</option>
                    }
                </select>
            </div>
            <button class="btn btn-primary" @onclick="GuardarDatosAsync">Guardar datos</button>

            @* Estado: activo, bloqueado *@
            <h2 class="h4 mt-5">Estado</h2>
            <p>
                @(detalle.Ficha.Activo ? "Activo" : "Desactivado")
                @if (detalle.Ficha.Bloqueado)
                {
                    <span class="wys-etiqueta ms-2">Bloqueado</span>
                }
                · Último acceso: @(detalle.Ficha.UltimoAcceso?.ToString("dd/MM/yyyy HH:mm") ?? "-")
            </p>
            @if (detalle.Ficha.Activo)
            {
                <button class="btn btn-danger" @onclick="() => CambiarActivoAsync(false)">Desactivar</button>
            }
            else
            {
                <button class="btn btn-primary" @onclick="() => CambiarActivoAsync(true)">Activar</button>
            }
            @if (detalle.Ficha.Bloqueado)
            {
                <button class="btn btn-primary ms-2" @onclick="DesbloquearAsync">Desbloquear</button>
            }

            @* Contraseña temporal *@
            <h2 class="h4 mt-5">Restablecer contraseña</h2>
            <p class="text-secondary small">Pon una contraseña temporal; se le pedirá cambiarla al entrar.</p>
            <div class="d-flex gap-2">
                <input type="password" class="form-control" @bind="passwordTemporal" autocomplete="new-password" placeholder="Contraseña temporal" />
                <button class="btn btn-primary text-nowrap" @onclick="RestablecerAsync">Restablecer</button>
            </div>
        </div>

        <div class="col-6">
            @* Permisos agrupados por área *@
            <h2 class="h4">Permisos</h2>
            @if (rol == Permisos.RolAdministrador_wys)
            {
                <p>El rol Administrador tiene todos los permisos.</p>
            }
            else
            {
                <p class="text-secondary small">Marca lo que puede hacer esta persona. Sin ninguna marca, no puede hacer nada.</p>
                @foreach (var area in Permisos.Catalogo_wys.GroupBy(p => p.Area))
                {
                    <h3 class="h6 mt-3">@area.Key</h3>
                    @foreach (var permiso in area)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="@permiso.Codigo"
                                   checked="@permisosMarcados.Contains(permiso.Codigo)"
                                   @onchange="e => MarcarPermiso(permiso.Codigo, (bool)e.Value!)" />
                            <label class="form-check-label" for="@permiso.Codigo">@permiso.Descripcion</label>
                        </div>
                    }
                }
                <button class="btn btn-primary mt-3" @onclick="GuardarPermisosAsync">Guardar permisos</button>
            }
        </div>
    </div>

    @* Quién y cuándo creó o modificó este usuario *@
    <p class="wys-trazabilidad">
        Creado por @detalle.CreadoPor el @detalle.FechaCreacion.ToString("dd/MM/yyyy HH:mm")
        @if (detalle.ModificadoPor is not null)
        {
            <span> · Modificado por @detalle.ModificadoPor el @detalle.FechaModificacion?.ToString("dd/MM/yyyy HH:mm")</span>
        }
    </p>
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    private DatosUsuario? detalle;
    private bool noExiste;
    private string nombreCompleto = "";
    private string rol = Permisos.RolUsuario_wys;
    private string passwordTemporal = "";
    private HashSet<string> permisosMarcados = [];
    private string? mensaje;
    private bool esError;

    /// <summary>
    /// Carga la ficha al abrir la pantalla.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        await CargarAsync();
    }

    /// <summary>
    /// Lee la ficha del usuario y rellena el formulario con sus datos actuales.
    /// </summary>
    private async Task CargarAsync()
    {
        detalle = await ServicioUsuarios.ObtenerAsync(Id);
        noExiste = detalle is null;
        if (detalle is not null)
        {
            nombreCompleto = detalle.Ficha.NombreCompleto;
            rol = detalle.Ficha.Rol;
            permisosMarcados = detalle.Permisos.ToHashSet();
        }
    }

    /// <summary>
    /// Muestra el resultado de una acción y, si ha ido bien, vuelve a cargar la ficha.
    /// </summary>
    private async Task MostrarResultadoAsync(string? error, string textoCorrecto)
    {
        esError = error is not null;
        mensaje = error ?? textoCorrecto;
        if (!esError)
        {
            await CargarAsync();
        }
    }

    private async Task GuardarDatosAsync() =>
        await MostrarResultadoAsync(await ServicioUsuarios.GuardarDatosAsync(Id, nombreCompleto, rol), "Datos guardados correctamente.");

    private async Task CambiarActivoAsync(bool activo) =>
        await MostrarResultadoAsync(await ServicioUsuarios.CambiarActivoAsync(Id, activo),
            activo ? "Usuario activado." : "Usuario desactivado: ya no puede entrar.");

    private async Task DesbloquearAsync() =>
        await MostrarResultadoAsync(await ServicioUsuarios.DesbloquearAsync(Id), "Usuario desbloqueado.");

    /// <summary>
    /// Pone la contraseña temporal y vacía el campo, para que no quede a la vista.
    /// </summary>
    private async Task RestablecerAsync()
    {
        var error = await ServicioUsuarios.RestablecerPasswordAsync(Id, passwordTemporal);
        passwordTemporal = "";
        await MostrarResultadoAsync(error, "Contraseña restablecida. Se le pedirá cambiarla al entrar.");
    }

    private void MarcarPermiso(string codigo, bool estaMarcado)
    {
        if (estaMarcado)
        {
            permisosMarcados.Add(codigo);
        }
        else
        {
            permisosMarcados.Remove(codigo);
        }
    }

    private async Task GuardarPermisosAsync() =>
        await MostrarResultadoAsync(await ServicioUsuarios.GuardarPermisosAsync(Id, permisosMarcados), "Permisos guardados correctamente.");
}
