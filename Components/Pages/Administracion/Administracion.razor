@page "/administracion"
@using VisualInspector.Components.Layout

<PageTitle>Administración · Visual Inspector</PageTitle>

@* Portada de la sección de Administración: las mismas opciones que el menú «Administración» *@
<h1>Administración</h1>
<p>Gestión de la aplicación. Solo la ven los administradores.</p>

<div class="row g-4 mt-2">
    @foreach (var opcion in OpcionesAdministracion.Lista_wys)
    {
        <div class="col-4">
            <a href="@opcion.Direccion" class="text-decoration-none">
                <div class="wys-caja wys-caja--azul h-100">
                    <span class="wys-icono-circulo wys-icono-circulo--azul mb-3">
                        <img src="@($"recursos/iconos/blanco/{opcion.Icono}.png")" alt="" />
                    </span>
                    <h2 class="h5 text-white">@opcion.Titulo</h2>
                    <p class="mb-0">@opcion.Texto</p>
                </div>
            </a>
        </div>
    }
</div>
