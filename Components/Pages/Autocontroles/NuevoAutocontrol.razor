@page "/autocontroles/nuevo"
@attribute [Authorize(Policy = Permisos.AutocontrolesRealizar_wys)]
@inject ServicioAutocontroles ServicioAutocontroles
@inject NavigationManager Navegacion

<PageTitle>Nuevo Autocontrol RPI · Visual Inspector</PageTitle>

@* Primer paso de un autocontrol: indicar la orden de fabricación. La fecha y hora y el número
   de control (1 = inicial, 2, 3…) los pone la aplicación *@
<h1>Nuevo Autocontrol RPI</h1>
<p><a href="autocontroles">Autocontroles</a> › Nuevo</p>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="row">
    <div class="col-6">
        @* Órdenes que siguen en fabricación: un clic rellena la orden y la línea *@
        @if (ordenesAbiertas.Count > 0)
        {
            <div class="mb-4">
                <h2 class="h5 mb-1">Órdenes de fabricación abiertas</h2>
                <p class="form-text mt-0 mb-2">Pulsa una para hacerle el siguiente control; se rellenan solas la orden y la línea.</p>
                <div class="vi-ordenes-abiertas">
                    @foreach (var o in ordenesAbiertas)
                    {
                        var transcurrido = DateTime.Now - o.UltimoControl;
                        var yaToca = transcurrido.TotalHours >= ServicioAutocontroles.HorasRecomendadasEntreControles_wys;
                        <button type="button" class="vi-orden-abierta @(yaToca ? "vi-orden-abierta--toca" : "") @(codigoOrden == o.Codigo ? "vi-orden-abierta--elegida" : "")"
                                @onclick="() => ElegirOrdenAsync(o)" disabled="@estaOcupado">
                            <span>
                                <strong>@o.Codigo</strong>
                                · @(o.Linea ?? "sin línea")
                                @if (o.Litografia is not null)
                                {
                                    <span> · @o.Litografia</span>
                                }
                            </span>
                            <span class="small">
                                Último control hace @ServicioAutocontroles.FormatearDuracion(transcurrido < TimeSpan.Zero ? TimeSpan.Zero : transcurrido)
                                → <strong>@o.SiguienteControl</strong>
                            </span>
                        </button>
                    }
                </div>
            </div>
            <h2 class="h5 mb-2">O escribe la orden</h2>
        }

        <div class="mb-3">
            <label class="form-label" for="orden">Orden de fabricación</label>
            @* El campo viene relleno con el inicio habitual de las órdenes (parámetro PrefijoOrden):
               el operario escribe el resto y, si hace falta, lo cambia como cualquier texto *@
            <input id="orden" class="form-control form-control-lg" maxlength="@ServicioAutocontroles.CifrasOrden_wys" inputmode="numeric"
                   autocomplete="off" autofocus
                   value="@codigoOrden" @oninput="CambiarOrdenAsync" />
            <div class="form-text">
                Exactamente 10 cifras, solo números.
                @if (prefijo.Length > 0)
                {
                    <span>Ya viene escrito el inicio habitual (@prefijo): añade el resto o cámbialo si la orden empieza distinto.</span>
                }
                Si la orden aún no existe, se crea en este momento.
            </div>
        </div>

        @if (prevision is not null)
        {
            <p>
                Será el <span class="wys-etiqueta">@prevision.Nombre</span> de esta orden,
                con fecha y hora de ahora.
            </p>
            <AvisoProximoControl FechaUltimo="prevision.FechaUltimo" />
        }

        @* Línea de fabricación (obligatoria): si la orden ya tiene autocontroles, viene elegida la
           del último. La orden se queda con la línea elegida *@
        <div class="mb-3" style="max-width: 16rem">
            <label class="form-label" for="linea">Línea</label>
            <select id="linea" class="form-select form-select-lg" value="@linea" @onchange="CambiarLineaAsync">
                <option value="">Elige la línea</option>
                @foreach (var l in lineas)
                {
                    <option value="@l">@l</option>
                }
            </select>
            <div class="form-text">Obligatoria. En una orden que ya tiene autocontroles viene elegida la de su último control.</div>
        </div>

        @* Una línea fabrica una orden a la vez: al empezar otra, la anterior de esa línea se finaliza.
           Se avisa aquí y, al pulsar Crear, hay que aceptarlo expresamente *@
        @if (ordenesACerrar.Count > 0)
        {
            <div class="alert @(esConfirmandoCierre ? "alert-danger" : "alert-warning")" role="alert">
                La línea @linea ya tiene @(ordenesACerrar.Count == 1 ? "otra orden" : "otras órdenes") en fabricación:
                <strong>@string.Join(", ", ordenesACerrar.Select(o => o.Codigo))</strong>.
                Si sigues, @(ordenesACerrar.Count == 1 ? "se finalizará" : "se finalizarán") y ya no
                @(ordenesACerrar.Count == 1 ? "admitirá" : "admitirán") autocontroles nuevos, salvo que el administrador
                @(ordenesACerrar.Count == 1 ? "la reabra" : "las reabra").
                @foreach (var o in ordenesACerrar.Where(o => o.SinRegistrar > 0))
                {
                    @* Los autocontroles sin registrar ya no se podrían registrar: se borran *@
                    <div class="mt-2">
                        <strong>
                            La orden @o.Codigo tiene @(o.SinRegistrar == 1 ? "1 autocontrol sin registrar y se borrará" : $"{o.SinRegistrar} autocontroles sin registrar y se borrarán").
                        </strong>
                        Si alguien lo está registrando ahora mismo, perderá su trabajo.
                    </div>
                }
                @if (esConfirmandoCierre)
                {
                    <div class="mt-3 fw-bold">¿Estás seguro? No se puede deshacer.</div>
                    <div class="mt-2 d-flex gap-2">
                        <button class="btn btn-danger btn-sm" @onclick="CrearAsync" disabled="@estaOcupado">Sí, finalizar y crear el autocontrol</button>
                        <button class="btn btn-outline-primary btn-sm" @onclick="() => esConfirmandoCierre = false" disabled="@estaOcupado">No, volver</button>
                    </div>
                }
            </div>
        }

        <div class="mb-3">
            <label class="form-label" for="observaciones">Observaciones (opcional)</label>
            <textarea id="observaciones" class="form-control" rows="3"
                      maxlength="@ServicioAutocontroles.LongitudMaximaObservaciones_wys"
                      @bind="observaciones"></textarea>
        </div>

        <button class="btn btn-primary btn-lg" @onclick="CrearAsync" disabled="@(estaOcupado || esConfirmandoCierre || prevision is null || string.IsNullOrEmpty(linea))">
            Crear autocontrol
        </button>
        <a href="autocontroles" class="btn btn-link">Cancelar</a>
    </div>
</div>

@code {
    private string codigoOrden = "";
    private string prefijo = "";
    private IReadOnlyList<string> lineas = [];
    private string linea = "";
    private IReadOnlyList<OrdenAbierta> ordenesAbiertas = [];
    private string? observaciones;
    private PrevisionControl? prevision;
    private IReadOnlyList<OrdenACerrar> ordenesACerrar = [];
    // El operario ha pulsado Crear y falta que acepte finalizar las órdenes anteriores de la línea
    private bool esConfirmandoCierre;
    private string? error;
    private bool estaOcupado;

    /// <summary>
    /// Al abrir la pantalla, el campo de la orden viene relleno con el inicio habitual de las
    /// órdenes (parámetro PrefijoOrden), para que el operario solo escriba el resto, y se cargan
    /// las líneas que se pueden elegir (parámetro Lineas) y las órdenes que siguen en fabricación.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        prefijo = await ServicioAutocontroles.ObtenerPrefijoOrdenAsync();
        codigoOrden = prefijo;
        lineas = await ServicioAutocontroles.ObtenerLineasAsync();
        ordenesAbiertas = await ServicioAutocontroles.ListarOrdenesAbiertasAsync();
    }

    /// <summary>
    /// Elige una orden en fabricación de la lista: rellena la orden y su línea y enseña qué
    /// control será, igual que si se hubiera escrito.
    /// </summary>
    private async Task ElegirOrdenAsync(OrdenAbierta orden)
    {
        error = null;
        codigoOrden = orden.Codigo;
        prevision = await ServicioAutocontroles.PrevisualizarControlAsync(codigoOrden);
        if (orden.Linea is not null && lineas.Contains(orden.Linea))
        {
            linea = orden.Linea;
        }
        await ActualizarAvisoCierreAsync();
    }

    /// <summary>
    /// Al elegir otra línea se vuelve a mirar qué orden anterior de esa línea se cerraría sola.
    /// </summary>
    private async Task CambiarLineaAsync(ChangeEventArgs e)
    {
        linea = e.Value?.ToString() ?? "";
        await ActualizarAvisoCierreAsync();
    }

    /// <summary>
    /// Mira si, con esta orden y esta línea, se finalizaría sola alguna orden anterior, para avisar.
    /// </summary>
    private async Task ActualizarAvisoCierreAsync()
    {
        // Si cambia la orden o la línea, lo que el operario iba a aceptar ya no es lo mismo
        esConfirmandoCierre = false;
        ordenesACerrar = await ServicioAutocontroles.ListarOrdenesACerrarAsync(codigoOrden, linea);
    }

    /// <summary>
    /// Cada vez que se escribe en la orden, deja solo las cifras y, cuando hay 10, enseña qué
    /// control será (RPI 1 (inicial), RPI 2…) y cuánto hace del último. Si la orden ya
    /// tiene línea (la de su último autocontrol), la deja elegida.
    /// </summary>
    private async Task CambiarOrdenAsync(ChangeEventArgs e)
    {
        codigoOrden = new string((e.Value?.ToString() ?? "").Where(char.IsAsciiDigit).Take(ServicioAutocontroles.CifrasOrden_wys).ToArray());
        prevision = codigoOrden.Length == ServicioAutocontroles.CifrasOrden_wys
            ? await ServicioAutocontroles.PrevisualizarControlAsync(codigoOrden)
            : null;
        if (prevision?.LineaOrden is { } lineaOrden && lineas.Contains(lineaOrden))
        {
            linea = lineaOrden;
        }
        await ActualizarAvisoCierreAsync();
    }

    /// <summary>
    /// Crea el autocontrol y abre su ficha. El botón se bloquea mientras tanto para que un
    /// doble clic no cree dos.
    /// </summary>
    private async Task CrearAsync()
    {
        error = null;

        // Si hay órdenes que se finalizarían, primero hay que aceptarlo: la primera pulsación solo
        // enseña la confirmación y la segunda («Sí, finalizar…») crea de verdad
        if (ordenesACerrar.Count > 0 && !esConfirmandoCierre)
        {
            esConfirmandoCierre = true;
            return;
        }

        estaOcupado = true;
        var resultado = await ServicioAutocontroles.CrearAsync(codigoOrden, linea, observaciones, aceptaCierre: esConfirmandoCierre);
        if (resultado.Id is not null)
        {
            Navegacion.NavigateTo($"autocontroles/{resultado.Id}");
            return;
        }

        error = resultado.Error;
        // Si algo ha cambiado (por ejemplo otra persona abrió una orden en la línea), se vuelve a
        // mirar qué se finalizaría y se pide de nuevo la aceptación
        await ActualizarAvisoCierreAsync();
        estaOcupado = false;
    }
}
