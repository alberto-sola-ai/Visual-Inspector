@using VisualInspector.Servicios.Vision
@inject ServicioAutocontroles ServicioAutocontroles

@* Lo que quedó registrado de un autocontrol. Solo lectura: un registro de fabricación no se cambia *@
<h2 class="h4 mt-5">Registro del autocontrol</h2>

<div class="d-flex flex-wrap gap-3 align-items-stretch">
    <div class="wys-caja @(Registro.Resultado == ResultadoAutocontrol.ConIncidencias ? "wys-caja--roja" : "wys-caja--azul")">
        <div class="small text-uppercase">Resultado</div>
        <div class="h4 text-white mb-0">@ServicioAutocontroles.NombreResultado(Registro.Resultado)</div>
    </div>
    <div class="border p-3 small">
        <div><strong>Patrón:</strong> @Registro.Litografia @Registro.VersionPatron</div>
        <div class="text-break text-secondary">@Registro.NombreArchivoPatron</div>
        @if (Registro.EsLitografiaDistintaConfirmada)
        {
            <div class="text-danger">Litografía distinta de la de la orden, confirmada por el operario.</div>
        }
    </div>
    <div class="border p-3 small">
        <div><strong>Tolerancia:</strong> @Registro.Tolerancia</div>
        <div><strong>Parecido</strong> (orientativo): muestra 1 @Porcentaje(Registro.SimilitudMuestra1) ·
            muestra 2 @Porcentaje(Registro.SimilitudMuestra2) · entre muestras @Porcentaje(Registro.SimilitudEntreMuestras)</div>
    </div>
    <div class="border p-3 small">
        <div><strong>Registrado por</strong> @Registro.RegistradoPor</div>
        <div>el @Registro.FechaRegistro?.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
</div>

@if (Registro.Diferencias.Count > 0)
{
    @* Diferencias con su validación, agrupadas por motivo *@
    @foreach (var grupo in Registro.Diferencias.GroupBy(d => d.Motivo))
    {
        <h3 class="h5 ps-2 mt-4" style="border-left: 6px solid @ComparacionAutocontrol.ColorCss(grupo.Key)">
            @ComparacionAutocontrol.NombreMotivo(grupo.Key) <span class="wys-ligero">(@grupo.Count())</span>
        </h3>
        <table class="table align-middle">
            <tbody>
                @foreach (var d in grupo)
                {
                    <tr>
                        <td style="width: 3rem" class="h5" >@d.Numero</td>
                        <td style="width: 45%">
                            <img src="@($"data:image/jpeg;base64,{Convert.ToBase64String(d.Recorte)}")"
                                 class="border" style="max-height: 120px; max-width: 100%" alt="Diferencia @d.Numero" />
                        </td>
                        <td class="small">
                            @if (d.Validacion == ValidacionDiferencia.Incidencia)
                            {
                                <span class="wys-etiqueta">Incidencia</span>
                            }
                            else
                            {
                                <span class="badge text-bg-success">Correcta</span>
                            }
                            <span class="ms-2">@(d.EnMuestra1 && d.EnMuestra2 ? "Las dos muestras" : d.EnMuestra1 ? "Muestra 1" : "Muestra 2")</span>
                            · @d.AnchoMm.ToString("N0") × @d.AltoMm.ToString("N0") mm
                            @if (d.Validacion == ValidacionDiferencia.Incidencia)
                            {
                                <div class="mt-1"><strong>Qué se hizo:</strong> @ServicioAutocontroles.DescribirActuaciones(d.Actuaciones)</div>
                                @if (TieneCifras(d))
                                {
                                    @* Minutos y tubos aproximados; quien puede hacer autocontroles los puede corregir *@
                                    <div class="mt-1">
                                        @if (d.Actuaciones!.Value.HasFlag(ActuacionIncidencia.ParadaLinea))
                                        {
                                            <span class="me-3">Parada: <strong>@(d.MinutosParada?.ToString("N0") ?? "sin dato") min</strong></span>
                                        }
                                        @if (d.Actuaciones!.Value.HasFlag(ActuacionIncidencia.RetencionProducto))
                                        {
                                            <span class="me-3">Tubos retenidos: <strong>@(d.TubosRetenidos?.ToString("N0") ?? "sin dato")</strong></span>
                                        }
                                        <span class="text-secondary">(aproximado)</span>
                                        @if (PuedeCorregir && editando != d.Id)
                                        {
                                            <AuthorizeView Policy="@Permisos.AutocontrolesRealizar_wys" Context="contextoCorregir">
                                                <button type="button" class="btn btn-link btn-sm py-0" @onclick="() => EmpezarCorreccion(d)">Corregir</button>
                                            </AuthorizeView>
                                        }
                                    </div>
                                    @if (editando == d.Id)
                                    {
                                        <div class="d-flex flex-wrap align-items-end gap-3 mt-2">
                                            @if (d.Actuaciones!.Value.HasFlag(ActuacionIncidencia.ParadaLinea))
                                            {
                                                <div>
                                                    <label class="form-label small mb-0" for="@($"corr-min-{d.Id}")">Minutos de parada</label>
                                                    <input id="@($"corr-min-{d.Id}")" type="number" min="1" max="@ServicioAutocontroles.MaximoMinutosParada_wys"
                                                           class="form-control form-control-sm" style="width: 9rem" @bind="minutosEditados" @bind:event="oninput" />
                                                </div>
                                            }
                                            @if (d.Actuaciones!.Value.HasFlag(ActuacionIncidencia.RetencionProducto))
                                            {
                                                <div>
                                                    <label class="form-label small mb-0" for="@($"corr-tub-{d.Id}")">Tubos retenidos</label>
                                                    <input id="@($"corr-tub-{d.Id}")" type="number" min="1" max="@ServicioAutocontroles.MaximoTubosRetenidos_wys"
                                                           class="form-control form-control-sm" style="width: 9rem" @bind="tubosEditados" @bind:event="oninput" />
                                                </div>
                                            }
                                            <button type="button" class="btn btn-primary btn-sm" @onclick="() => GuardarCorreccionAsync(d)" disabled="@estaGuardando">Guardar</button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="() => editando = null" disabled="@estaGuardando">Cancelar</button>
                                        </div>
                                        @if (errorCorreccion is not null)
                                        {
                                            <div class="form-text text-danger">@errorCorreccion</div>
                                        }
                                    }
                                }
                            }
                            @if (!string.IsNullOrEmpty(d.Comentario))
                            {
                                @* El comentario se muestra como texto (Blazor lo escapa): nunca como HTML *@
                                <div class="mt-1" style="white-space: pre-line">@d.Comentario</div>
                            }
                            <div class="wys-trazabilidad mt-1">Validada por @d.ValidadoPor el @d.FechaValidacion.ToString("dd/MM/yyyy HH:mm")</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<details class="small text-secondary mt-3">
    <summary>Huellas de los archivos usados (SHA-256)</summary>
    <div class="mt-2">
        Patrón: <code class="text-break">@Registro.HuellaPatron</code><br />
        Muestra 1: <code class="text-break">@Registro.HuellaMuestra1</code><br />
        Muestra 2: <code class="text-break">@Registro.HuellaMuestra2</code>
    </div>
    <p class="mt-2 mb-0">Los archivos no se guardan; la huella permite comprobar más adelante si un archivo es exactamente el que se usó.</p>
</details>

@code {
    [Parameter, EditorRequired]
    public DatosRegistro Registro { get; set; } = default!;

    // Un autocontrol anulado ya no se corrige
    [Parameter]
    public bool PuedeCorregir { get; set; }

    // Avisa a la ficha para que vuelva a leer los datos después de corregir
    [Parameter]
    public EventCallback OnImpactoCorregido { get; set; }

    private int? editando;
    private int? minutosEditados;
    private int? tubosEditados;
    private string? errorCorreccion;
    private bool estaGuardando;

    /// <summary>
    /// Dice si la incidencia tuvo parada o retención, que son las que llevan cifras aproximadas.
    /// </summary>
    private static bool TieneCifras(DiferenciaRegistrada d) =>
        d.Actuaciones is { } a && (a.HasFlag(ActuacionIncidencia.ParadaLinea) || a.HasFlag(ActuacionIncidencia.RetencionProducto));

    /// <summary>
    /// Abre el formulario de corrección con las cifras actuales.
    /// </summary>
    private void EmpezarCorreccion(DiferenciaRegistrada d)
    {
        editando = d.Id;
        minutosEditados = d.MinutosParada;
        tubosEditados = d.TubosRetenidos;
        errorCorreccion = null;
    }

    /// <summary>
    /// Guarda las cifras corregidas. El servicio vuelve a comprobar el permiso y que tengan sentido.
    /// </summary>
    private async Task GuardarCorreccionAsync(DiferenciaRegistrada d)
    {
        estaGuardando = true;
        errorCorreccion = await ServicioAutocontroles.CorregirImpactoAsync(d.Id, minutosEditados, tubosEditados);
        estaGuardando = false;
        if (errorCorreccion is null)
        {
            editando = null;
            await OnImpactoCorregido.InvokeAsync();
        }
    }

    private static string Porcentaje(decimal? valor) => valor is null ? "-" : $"{valor.Value:N0} %";
}
