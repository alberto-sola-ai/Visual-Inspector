@using VisualInspector.Servicios.Vision
@inject ComparadorMuestras Comparador
@inject ServicioParametros ServicioParametros
@inject ServicioAutocontroles ServicioAutocontroles
@inject ILogger<ComparacionAutocontrol> Registro

@* Comparación con el patrón y formulario de validación. Pensado para un autocontrol rápido: el
   operario ve primero las diferencias más evidentes, agrupadas por motivo, y las valida *@
<h2 class="h4 mt-5">Comparación con el patrón</h2>

<div class="d-flex flex-wrap gap-3 align-items-center">
    <div>
        <span class="me-2">Tolerancia:</span>
        <div class="btn-group" role="group" aria-label="Tolerancia">
            @foreach (var nivel in Enum.GetValues<NivelTolerancia>())
            {
                <button type="button" class="btn @(tolerancia == nivel ? "btn-primary" : "btn-outline-primary")"
                        disabled="@(estaComparando || estaRegistrando)" @onclick="() => CambiarToleranciaAsync(nivel)">
                    @nivel
                </button>
            }
        </div>
    </div>
    @if (resultado is null)
    {
        <button class="btn btn-primary btn-lg" @onclick="CompararAsync" disabled="@estaComparando">
            Comparar con el patrón
        </button>
    }
    @if (estaComparando)
    {
        <span>Comparando… tarda unos segundos.</span>
    }
</div>
<p class="small text-secondary mt-2 mb-0">
    Estricta: avisa también de diferencias pequeñas o suaves. Normal: equilibrio para un autocontrol
    rápido. Amplia: solo lo más claro. Se compara el contenido (manchas, faltas, textos corridos);
    no se analiza el color, ni se tienen en cuenta pliegues ni bordes.
    @if (resultado is not null)
    {
        <strong>Al cambiar la tolerancia se vuelve a comparar y se pierden las validaciones hechas.</strong>
    }
</p>

@if (error is not null)
{
    <div class="alert alert-danger mt-3" role="alert">@error</div>
}

@if (resultado is { } r)
{
    @foreach (var aviso in r.Avisos)
    {
        <div class="alert alert-warning mt-3" role="alert">@aviso</div>
    }

    @* Resumen: diferencias por motivo y parecido orientativo *@
    <div class="d-flex flex-wrap gap-3 mt-3 align-items-stretch">
        @if (r.Diferencias.Count == 0)
        {
            <div class="wys-caja wys-caja--azul">
                <strong>Sin diferencias</strong> con tolerancia @r.Tolerancia.
            </div>
        }
        @foreach (var motivo in Enum.GetValues<MotivoDiferencia>())
        {
            var cantidad = r.Diferencias.Count(d => d.Motivo == motivo);
            if (cantidad == 0) continue;
            <div class="border p-3" style="border-left: 8px solid @ColorCss(motivo) !important">
                <div class="h3 mb-0">@cantidad</div>
                <div>@NombreMotivo(motivo)</div>
            </div>
        }
        <div class="border p-3 small">
            <div><strong>Parecido con el patrón</strong> (orientativo)</div>
            <div>Muestra 1: @Porcentaje(r.SimilitudMuestra1) · Muestra 2: @Porcentaje(r.SimilitudMuestra2)</div>
            <div>Entre las dos muestras: @Porcentaje(r.SimilitudEntreMuestras)</div>
        </div>
    </div>

    @if (r.Diferencias.Count > 0)
    {
        <div class="row g-4 mt-1">
            @* Vista general: dónde está cada diferencia *@
            <div class="col-5">
                @if (r.VistaGeneral is not null)
                {
                    <div class="sticky-top" style="top: 1rem">
                        <img src="@($"data:image/jpeg;base64,{Convert.ToBase64String(r.VistaGeneral)}")"
                             class="img-fluid border" alt="Patrón con las diferencias numeradas" />
                        <p class="small text-secondary mt-2">Cada número es una diferencia; el color indica su motivo.</p>
                    </div>
                }
            </div>

            @* Diferencias agrupadas por motivo, con su validación *@
            <div class="col-7">
                @foreach (var grupo in r.Diferencias.GroupBy(d => d.Motivo).OrderByDescending(g => g.Max(d => d.Evidencia)))
                {
                    var estaAbierto = gruposAbiertos.Contains(grupo.Key);
                    var visibles = estaAbierto ? grupo.ToList() : grupo.Take(MaximoVisibles_wys).ToList();
                    var pendientesGrupo = grupo.Count(d => validaciones[d.Numero].Validacion is null);
                    <div class="mb-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <h3 class="h5 ps-2 mb-0" style="border-left: 6px solid @ColorCss(grupo.Key)">
                                @NombreMotivo(grupo.Key) <span class="wys-ligero">(@grupo.Count())</span>
                            </h3>
                            @if (pendientesGrupo > 0)
                            {
                                <button class="btn btn-outline-success btn-sm" disabled="@estaRegistrando"
                                        @onclick="() => MarcarPendientesCorrectas(grupo)">
                                    Marcar pendientes como correctas (@pendientesGrupo)
                                </button>
                            }
                        </div>
                        @foreach (var d in visibles)
                        {
                            var v = validaciones[d.Numero];
                            <div class="d-flex gap-3 align-items-start border-bottom py-2">
                                <div class="h4 mb-0" style="min-width: 2.5rem; color: @ColorCss(d.Motivo)">@d.Numero</div>
                                <div class="flex-grow-1">
                                    <img src="@($"data:image/jpeg;base64,{Convert.ToBase64String(d.Recorte)}")"
                                         class="border" style="max-height: 140px; max-width: 100%" alt="Diferencia @d.Numero" />
                                    <div class="small mt-1">
                                        @if (d.EnLasDos)
                                        {
                                            <span class="wys-etiqueta">Las dos muestras</span>
                                            <span class="text-secondary">posible fallo de plancha</span>
                                        }
                                        else
                                        {
                                            <strong>Solo muestra @(d.EnMuestra1 ? 1 : 2)</strong>
                                        }
                                        · zona de @d.AnchoMm.ToString("N0") × @d.AltoMm.ToString("N0") mm
                                        · @d.AreaMm2.ToString("N1") mm² distintos
                                    </div>

                                    @* Validación: correcta o incidencia (con comentario obligatorio) *@
                                    <div class="d-flex gap-2 mt-2">
                                        <button class="btn btn-sm @(v.Validacion == ValidacionDiferencia.Correcta ? "btn-success" : "btn-outline-success")"
                                                disabled="@estaRegistrando" @onclick="() => MarcarCorrecta(v)">
                                            Correcta
                                        </button>
                                        <button class="btn btn-sm @(v.Validacion == ValidacionDiferencia.Incidencia ? "btn-danger" : "btn-outline-danger")"
                                                disabled="@estaRegistrando" @onclick="() => v.Validacion = ValidacionDiferencia.Incidencia">
                                            Incidencia
                                        </button>
                                    </div>
                                    @if (v.Validacion == ValidacionDiferencia.Incidencia)
                                    {
                                        @* ¿Qué se ha hecho en producción? Se marca todo lo que corresponda; "Sin intervención" va sola *@
                                        <div class="mt-2">
                                            <div class="small fw-bold">¿Qué se ha hecho? <span class="fw-normal text-secondary">Marca todo lo que corresponda.</span></div>
                                            <div class="d-flex flex-wrap gap-3 mt-1">
                                                @foreach (var actuacion in ServicioAutocontroles.ActuacionesDisponibles_wys)
                                                {
                                                    var idActuacion = $"actuacion-{d.Numero}-{(int)actuacion}";
                                                    <div class="form-check mb-0">
                                                        <input class="form-check-input" type="checkbox" id="@idActuacion"
                                                               checked="@v.Actuaciones.HasFlag(actuacion)" disabled="@estaRegistrando"
                                                               @onchange="() => AlternarActuacion(v, actuacion)" />
                                                        <label class="form-check-label" for="@idActuacion">@ServicioAutocontroles.NombreActuacion(actuacion)</label>
                                                    </div>
                                                }
                                            </div>
                                            @if (!ServicioAutocontroles.EsActuacionValida(v.Actuaciones))
                                            {
                                                <div class="form-text text-danger">Marca al menos una opción.</div>
                                            }
                                            else if (v.Actuaciones.HasFlag(ActuacionIncidencia.ParadaLinea) || v.Actuaciones.HasFlag(ActuacionIncidencia.RetencionProducto))
                                            {
                                                @* Cifras aproximadas: luego se pueden corregir desde la ficha del autocontrol *@
                                                <div class="d-flex flex-wrap gap-3 mt-2">
                                                    @if (v.Actuaciones.HasFlag(ActuacionIncidencia.ParadaLinea))
                                                    {
                                                        <div>
                                                            <label class="form-label small mb-0" for="@($"minutos-{d.Numero}")">Minutos de parada (aprox.)</label>
                                                            <input id="@($"minutos-{d.Numero}")" type="number" min="1" max="@ServicioAutocontroles.MaximoMinutosParada_wys"
                                                                   class="form-control form-control-sm" style="width: 11rem"
                                                                   @bind="v.Minutos" @bind:event="oninput" disabled="@estaRegistrando" />
                                                        </div>
                                                    }
                                                    @if (v.Actuaciones.HasFlag(ActuacionIncidencia.RetencionProducto))
                                                    {
                                                        <div>
                                                            <label class="form-label small mb-0" for="@($"tubos-{d.Numero}")">Tubos retenidos (aprox.)</label>
                                                            <input id="@($"tubos-{d.Numero}")" type="number" min="1" max="@ServicioAutocontroles.MaximoTubosRetenidos_wys"
                                                                   class="form-control form-control-sm" style="width: 11rem"
                                                                   @bind="v.Tubos" @bind:event="oninput" disabled="@estaRegistrando" />
                                                        </div>
                                                    }
                                                </div>
                                                @if (ServicioAutocontroles.ComprobarImpacto(v.Actuaciones, v.Minutos, v.Tubos) is { } avisoImpacto)
                                                {
                                                    <div class="form-text text-danger">@avisoImpacto</div>
                                                }
                                                else
                                                {
                                                    <div class="form-text">Una cifra aproximada vale; se puede corregir después en la ficha del autocontrol.</div>
                                                }
                                            }
                                        </div>
                                        <textarea class="form-control form-control-sm mt-2 @(string.IsNullOrWhiteSpace(v.Comentario) ? "is-invalid" : "")"
                                                  rows="2" maxlength="@ServicioAutocontroles.LongitudMaximaComentario_wys"
                                                  @bind="v.Comentario" @bind:event="oninput" disabled="@estaRegistrando"></textarea>
                                        <div class="form-text">Comentario obligatorio: explica qué pasa.</div>
                                    }
                                </div>
                            </div>
                        }
                        @if (grupo.Count() > MaximoVisibles_wys)
                        {
                            <button class="btn btn-link px-0" @onclick="() => AlternarGrupo(grupo.Key)">
                                @(estaAbierto ? "Ver menos" : $"Ver más ({grupo.Count() - MaximoVisibles_wys})")
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @* Registro del autocontrol *@
    <div class="border-top mt-4 pt-3">
        @if (r.Avisos.Count > 0)
        {
            <div class="alert alert-warning" role="alert">
                No se puede registrar: alguna muestra no se ha podido comparar. Revisa los archivos.
            </div>
        }
        else
        {
            @if (EsLitografiaDistinta)
            {
                <div class="alert alert-warning" role="alert">
                    La litografía del patrón (<strong>@Litografia</strong>) no coincide con la de esta orden
                    (<strong>@LitografiaOrden</strong>). ¿Es el patrón correcto?
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="confirmarLitografia" @bind="esLitografiaConfirmada" />
                        <label class="form-check-label" for="confirmarLitografia">Confirmo que el patrón es el correcto</label>
                    </div>
                </div>
            }
            <div class="d-flex gap-3 align-items-center">
                <button class="btn btn-danger btn-lg" @onclick="RegistrarAsync" disabled="@(!PuedeRegistrar || estaRegistrando)">
                    Registrar autocontrol
                </button>
                @if (Pendientes > 0)
                {
                    <span>Pendientes de validar: <strong>@Pendientes</strong></span>
                }
                @if (IncidenciasSinComentario > 0)
                {
                    <span class="text-danger">Incidencias sin comentario: <strong>@IncidenciasSinComentario</strong></span>
                }
                @if (IncidenciasSinActuacion > 0)
                {
                    <span class="text-danger">Incidencias sin indicar qué se ha hecho: <strong>@IncidenciasSinActuacion</strong></span>
                }
                @if (IncidenciasSinCifras > 0)
                {
                    <span class="text-danger">Incidencias sin minutos o tubos: <strong>@IncidenciasSinCifras</strong></span>
                }
                @if (estaRegistrando)
                {
                    <span>Registrando…</span>
                }
            </div>
            <p class="small text-secondary mt-2">
                Al registrar se guardan el resultado, cada diferencia con su recorte y su validación, y
                las huellas de los archivos. Después ya no se puede cambiar.
            </p>
        }
    </div>
}

@code {
    // Para un autocontrol rápido, de cada motivo se enseñan solo las más evidentes
    private const int MaximoVisibles_wys = 5;

    [Parameter, EditorRequired] public int AutocontrolId { get; set; }
    [Parameter, EditorRequired] public ArchivoPreparado Patron { get; set; } = default!;
    [Parameter, EditorRequired] public ArchivoPreparado Muestra1 { get; set; } = default!;
    [Parameter, EditorRequired] public ArchivoPreparado Muestra2 { get; set; } = default!;
    [Parameter, EditorRequired] public string Litografia { get; set; } = "";
    [Parameter, EditorRequired] public string VersionPatron { get; set; } = "";
    [Parameter] public string? LitografiaOrden { get; set; }
    [Parameter] public EventCallback OnRegistrado { get; set; }

    private NivelTolerancia tolerancia = NivelTolerancia.Normal;
    private ResultadoComparacion? resultado;
    private bool estaComparando;
    private bool estaRegistrando;
    private bool esLitografiaConfirmada;
    private string? error;
    private readonly HashSet<MotivoDiferencia> gruposAbiertos = [];
    private Dictionary<int, EstadoValidacion> validaciones = [];

    /// <summary>
    /// Lo que va decidiendo el operario sobre cada diferencia.
    /// </summary>
    private sealed class EstadoValidacion
    {
        public ValidacionDiferencia? Validacion { get; set; }
        public string? Comentario { get; set; }

        // Qué se hizo en producción; solo se pide en las incidencias
        public ActuacionIncidencia Actuaciones { get; set; }

        // Cifras aproximadas: minutos de parada y tubos retenidos (solo si se marcó parada o retención)
        public int? Minutos { get; set; }
        public int? Tubos { get; set; }
    }

    /// <summary>
    /// Marca una diferencia como correcta. Si antes era una incidencia, se borra lo que se había
    /// marcado de actuaciones: en una diferencia correcta no hay nada que hacer en producción.
    /// </summary>
    private static void MarcarCorrecta(EstadoValidacion estado)
    {
        estado.Validacion = ValidacionDiferencia.Correcta;
        estado.Actuaciones = ActuacionIncidencia.Ninguna;
        estado.Minutos = null;
        estado.Tubos = null;
    }

    /// <summary>
    /// Marca o desmarca una actuación de una incidencia. "Sin intervención" se queda sola: al marcarla
    /// se quitan las demás y al marcar cualquier otra se quita ella.
    /// </summary>
    private static void AlternarActuacion(EstadoValidacion estado, ActuacionIncidencia actuacion)
    {
        if (actuacion == ActuacionIncidencia.SinIntervencion)
        {
            estado.Actuaciones = estado.Actuaciones == ActuacionIncidencia.SinIntervencion
                ? ActuacionIncidencia.Ninguna
                : ActuacionIncidencia.SinIntervencion;
        }
        else
        {
            estado.Actuaciones &= ~ActuacionIncidencia.SinIntervencion;
            estado.Actuaciones ^= actuacion;
        }

        // Si ya no hay parada o retención, sus cifras se borran para no guardar datos sueltos
        if (!estado.Actuaciones.HasFlag(ActuacionIncidencia.ParadaLinea)) estado.Minutos = null;
        if (!estado.Actuaciones.HasFlag(ActuacionIncidencia.RetencionProducto)) estado.Tubos = null;
    }

    private bool EsLitografiaDistinta =>
        LitografiaOrden is not null && !string.Equals(LitografiaOrden, Litografia, StringComparison.OrdinalIgnoreCase);

    private int Pendientes => validaciones.Values.Count(v => v.Validacion is null);

    private int IncidenciasSinComentario => validaciones.Values.Count(v =>
        v.Validacion == ValidacionDiferencia.Incidencia && string.IsNullOrWhiteSpace(v.Comentario));

    private int IncidenciasSinActuacion => validaciones.Values.Count(v =>
        v.Validacion == ValidacionDiferencia.Incidencia && !ServicioAutocontroles.EsActuacionValida(v.Actuaciones));

    // Incidencias con actuación válida pero sin los minutos o los tubos que esa actuación pide
    private int IncidenciasSinCifras => validaciones.Values.Count(v =>
        v.Validacion == ValidacionDiferencia.Incidencia && ServicioAutocontroles.EsActuacionValida(v.Actuaciones)
        && ServicioAutocontroles.ComprobarImpacto(v.Actuaciones, v.Minutos, v.Tubos) is not null);

    private bool PuedeRegistrar => resultado is not null && resultado.Avisos.Count == 0
        && Pendientes == 0 && IncidenciasSinComentario == 0 && IncidenciasSinActuacion == 0 && IncidenciasSinCifras == 0
        && (!EsLitografiaDistinta || esLitografiaConfirmada);

    /// <summary>
    /// Al abrir, la tolerancia es la que ha fijado el administrador (parámetro ToleranciaPorDefecto).
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var valor = await ServicioParametros.ObtenerValorAsync(ServicioParametros.ToleranciaPorDefecto_wys, nameof(NivelTolerancia.Normal));
        tolerancia = Enum.TryParse<NivelTolerancia>(valor, out var nivel) ? nivel : NivelTolerancia.Normal;
    }

    /// <summary>
    /// Cambia la tolerancia; si ya se había comparado, se repite la comparación con la nueva.
    /// </summary>
    private async Task CambiarToleranciaAsync(NivelTolerancia nivel)
    {
        if (nivel == tolerancia) return;
        tolerancia = nivel;
        if (resultado is not null)
        {
            await CompararAsync();
        }
    }

    /// <summary>
    /// Compara las dos muestras con el patrón y prepara una validación vacía para cada diferencia.
    /// Si algo falla, mensaje amable y detalle en el diario.
    /// </summary>
    private async Task CompararAsync()
    {
        estaComparando = true;
        error = null;
        try
        {
            resultado = await Comparador.CompararAsync(Patron, Muestra1, Muestra2, tolerancia);
            validaciones = resultado.Diferencias.ToDictionary(d => d.Numero, _ => new EstadoValidacion());
            gruposAbiertos.Clear();
        }
        catch (TimeoutException)
        {
            error = "La comparación está tardando demasiado. Comprueba los archivos e inténtalo de nuevo.";
        }
        catch (ArchivoNoValidoException e)
        {
            error = e.Message;
        }
        catch (Exception e) when (e is not AccesoDenegadoException)
        {
            var codigo = CodigoError.Generar();
            Registro.LogError(e, "Error {Codigo} al comparar las muestras", codigo);
            error = $"Algo no ha ido bien al comparar. Si se repite, avisa a IT indicando este código: {codigo}.";
        }
        finally
        {
            estaComparando = false;
        }
    }

    /// <summary>
    /// Marca como correctas todas las diferencias del grupo que aún no tienen decisión (también las
    /// que están plegadas en "Ver más"). Las que ya son incidencia no se tocan.
    /// </summary>
    private void MarcarPendientesCorrectas(IEnumerable<DiferenciaDetectada> grupo)
    {
        foreach (var d in grupo)
        {
            validaciones[d.Numero].Validacion ??= ValidacionDiferencia.Correcta;
        }
    }

    /// <summary>
    /// Registra el autocontrol con todas las validaciones. El servicio vuelve a comprobarlo todo.
    /// </summary>
    private async Task RegistrarAsync()
    {
        if (resultado is null || !PuedeRegistrar) return;
        estaRegistrando = true;
        error = null;
        try
        {
            var solicitud = new SolicitudRegistro(AutocontrolId, Patron.NombreArchivo, Litografia, VersionPatron,
                Patron.Huella, Muestra1.Huella, Muestra2.Huella, resultado.Tolerancia,
                resultado.SimilitudMuestra1, resultado.SimilitudMuestra2, resultado.SimilitudEntreMuestras,
                resultado.Diferencias.Select(d => new DiferenciaValidada(d, validaciones[d.Numero].Validacion, validaciones[d.Numero].Comentario, validaciones[d.Numero].Actuaciones,
                    validaciones[d.Numero].Minutos, validaciones[d.Numero].Tubos)).ToList(),
                EsLitografiaDistinta && esLitografiaConfirmada);
            error = await ServicioAutocontroles.RegistrarAsync(solicitud);
            if (error is null)
            {
                await OnRegistrado.InvokeAsync();
            }
        }
        catch (Exception e) when (e is not AccesoDenegadoException)
        {
            var codigo = CodigoError.Generar();
            Registro.LogError(e, "Error {Codigo} al registrar el autocontrol", codigo);
            error = $"Algo no ha ido bien al registrar. Si se repite, avisa a IT indicando este código: {codigo}.";
        }
        finally
        {
            estaRegistrando = false;
        }
    }

    private void AlternarGrupo(MotivoDiferencia motivo)
    {
        if (!gruposAbiertos.Remove(motivo))
        {
            gruposAbiertos.Add(motivo);
        }
    }

    /// <summary>
    /// Nombre de cada motivo para la pantalla.
    /// </summary>
    public static string NombreMotivo(MotivoDiferencia motivo) => motivo switch
    {
        MotivoDiferencia.Mancha => "Mancha o suciedad",
        MotivoDiferencia.Falta => "Falta elemento o tinta",
        _ => "Desplazamiento o texto doble"
    };

    // Mismos colores que la vista general: rojo WYS, azul WYS y naranja
    public static string ColorCss(MotivoDiferencia motivo) => motivo switch
    {
        MotivoDiferencia.Mancha => "var(--wys-rojo)",
        MotivoDiferencia.Falta => "var(--wys-azul-brillante)",
        _ => "#FF8C00"
    };

    private static string Porcentaje(double? valor) => valor is null ? "-" : $"{valor.Value:N0} %";
}
