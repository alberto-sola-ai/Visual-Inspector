@inject NavigationManager Navegacion

@* No muestra nada: solo vigila si la persona tiene pendiente cambiar su contraseña *@

@code {
    // Pantallas que se pueden ver aunque falte cambiar la contraseña
    private static readonly string[] RutasPermitidas_wys =
        ["account/manage/changepassword", "account/login", "account/lockout", "error", "not-found"];

    [CascadingParameter]
    private Task<AuthenticationState>? EstadoSesion { get; set; }

    /// <summary>
    /// Si la persona entró con una contraseña temporal, la manda a cambiarla antes de dejarle
    /// hacer nada más, como cuando te dan las llaves de un piso y lo primero es cambiar la cerradura.
    /// (La protección de verdad está en el servidor: sin cambiarla, no tiene ningún permiso.)
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (EstadoSesion is null)
        {
            return;
        }

        var persona = (await EstadoSesion).User;
        if (!persona.HasClaim(c => c.Type == Permisos.TipoClaimDebeCambiarPassword_wys))
        {
            return;
        }

        var ruta = Navegacion.ToBaseRelativePath(Navegacion.Uri).ToLowerInvariant();
        if (!RutasPermitidas_wys.Any(ruta.StartsWith))
        {
            Navegacion.NavigateTo("Account/Manage/ChangePassword", forceLoad: true);
        }
    }
}
