@* Botón con un ojo dentro de un campo de contraseña: al pulsarlo se ve lo escrito y al volver a
   pulsarlo se oculta. Lo hace wwwroot/js/mostrar-password.js; el ojo es un dibujo propio porque
   entre los iconos corporativos no hay ninguno de "ver" *@
<button type="button" class="vi-ojo" data-mostrar-password="@IdCampo"
        aria-label="Mostrar contraseña" title="Mostrar contraseña" aria-pressed="false">
    @* Ojo abierto: la contraseña está oculta y se puede mostrar *@
    <svg class="vi-ojo__abierto" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        <circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.6" />
    </svg>
    @* Ojo tachado: la contraseña se está viendo y se puede ocultar *@
    <svg class="vi-ojo__tachado" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
        <circle cx="12" cy="12" r="3.2" fill="none" stroke="currentColor" stroke-width="1.6" />
        <line x1="4" y1="20" x2="20" y2="4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
</button>

@code {
    /// <summary>
    /// El id del campo de contraseña que controla este botón.
    /// </summary>
    [Parameter, EditorRequired]
    public string IdCampo { get; set; } = "";
}
